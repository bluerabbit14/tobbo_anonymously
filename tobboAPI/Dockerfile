FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY tobboAPI.csproj ./
RUN dotnet restore tobboAPI.csproj

COPY . ./
RUN dotnet publish tobboAPI.csproj -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

EXPOSE 8080

USER $APP_UID

ENTRYPOINT ["sh", "-c", "dotnet tobboAPI.dll --urls http://0.0.0.0:${PORT:-8080}"]
